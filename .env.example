# Server
PORT=3001
NODE_ENV=development

# Auth0 — validates identity on each protected request
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_M2M_CLIENT_ID=your-management-api-client-id
AUTH0_M2M_CLIENT_SECRET=your-management-api-client-secret
AUTH0_DB_CONNECTION=Username-Password-Authentication

# Neon PostgreSQL — stores approved app users, roles, and profile data
# Neon: use sslmode=verify-full (avoids pg v8 deprecation warning for sslmode=require)
DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full

# Frontend origin allowed by CORS (e.g. Vite dev server or production app URL)
FRONTEND_ORIGIN=http://localhost:5173

# Fallback role when `AUTH0_ROLES_CLAIM` is unset or roles are omitted from the token (default learner)
# DEFAULT_NEW_USER_ROLE=instructor

# Optional: claim key where Auth0 Actions put roles (string | string[] | { name }[])
# Example Auth0 Action: api.accessToken.setCustomClaim('https://yourapp.com/roles', event.authorization.roles.map(r => r.name))
# AUTH0_ROLES_CLAIM=https://yourapp.com/roles

# Optional: custom claim key for email if not using standard `email` on the access token
# AUTH0_EMAIL_CLAIM=https://yourapp.com/email

# Contentful — Content Delivery API (published content)
# Space ID: Contentful → Settings → General settings
# Access token: Contentful → Settings → API keys → Content delivery / preview token
CONTENTFUL_SPACE_ID=your-space-id
CONTENTFUL_ACCESS_TOKEN=your-content-delivery-api-access-token
# Optional: defaults to master
# CONTENTFUL_ENVIRONMENT=master
# Optional: draft/preview content (Content Preview API)
# CONTENTFUL_PREVIEW_ACCESS_TOKEN=your-content-preview-api-access-token
# Optional: Contentful content type id for courses (default course)
# CONTENTFUL_COURSE_CONTENT_TYPE=course
